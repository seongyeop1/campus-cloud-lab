#!/usr/bin/env python3
"""Campus Cloud Lab 관리 도구 (표준 라이브러리만 사용).

  labctl init --students N          학생별 무작위 비밀번호와 bcrypt 해시 생성
  labctl render --mode local|deploy compose.yaml, Caddyfile 생성
  labctl reset sNN                  학생 홈 디렉터리 초기화
"""
import argparse
import json
import os
import re
import secrets
import subprocess
import sys
from pathlib import Path

CADDY_IMAGE = "caddy:2.8.4-alpine"
STUDENT_IMAGE = "campus-lab/student:1"
PROJECT = "campus-lab"
TTYD_PORT = 7681
LOCAL_PORT = 8080
MAX_STUDENTS = 99
PASSWORD_LENGTH = 16
# 헷갈리는 글자(0 O 1 l I)는 뺀다.
PASSWORD_ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789"

MEM_LIMIT = "512m"
CPU_LIMIT = "0.5"
PIDS_LIMIT = 256

STUDENT_ID_RE = re.compile(r"^s\d{2}$")
DOMAIN_RE = re.compile(r"^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,}$|^[0-9.]+\.sslip\.io$")


class LabError(Exception):
    pass


class Paths:
    def __init__(self, base):
        self.base = Path(base)
        self.secrets = self.base / "secrets"
        self.out = self.base / "out"
        self.roster = self.secrets / "students.csv"
        self.hashes = self.secrets / "hashes.json"
        self.compose = self.out / "compose.yaml"
        self.caddyfile = self.out / "Caddyfile"


def student_ids(count):
    return [f"s{i:02d}" for i in range(1, count + 1)]


def generate_password():
    return "".join(secrets.choice(PASSWORD_ALPHABET) for _ in range(PASSWORD_LENGTH))


def caddy_hash_password(password):
    """caddy hash-password를 컨테이너로 실행한다. 비밀번호는 인자가 아닌 환경 변수로 넘긴다."""
    env = dict(os.environ, LAB_PW=password)
    cmd = ["docker", "run", "--rm", "-e", "LAB_PW", CADDY_IMAGE,
           "sh", "-c", 'caddy hash-password --plaintext "$LAB_PW"']
    try:
        res = subprocess.run(cmd, env=env, capture_output=True, text=True, check=True)
    except FileNotFoundError:
        raise LabError("docker를 찾을 수 없습니다. 해시 생성에 docker가 필요합니다.")
    except subprocess.CalledProcessError as e:
        raise LabError(f"비밀번호 해시 생성 실패: {e.stderr.strip()}")
    hashed = res.stdout.strip()
    if not hashed.startswith("$2"):
        raise LabError(f"bcrypt 해시가 아닙니다: {hashed[:10]}")
    return hashed


def write_private(path, text):
    """소유자만 읽고 쓰게 만든다 (파일을 만드는 순간부터 0600)."""
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path.parent, 0o700)
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(path, 0o600)


def cmd_init(paths, count, force=False, hasher=caddy_hash_password):
    if not 1 <= count <= MAX_STUDENTS:
        raise LabError(f"--students는 1~{MAX_STUDENTS} 사이여야 합니다.")
    if (paths.roster.exists() or paths.hashes.exists()) and not force:
        raise LabError(f"{paths.secrets} 에 이미 명단이 있습니다. 새로 만들려면 --force (기존 비밀번호는 무효가 됩니다).")
    ids = student_ids(count)
    passwords = {sid: generate_password() for sid in ids}
    hashes = {sid: hasher(pw) for sid, pw in passwords.items()}
    roster = "id,password\n" + "".join(f"{sid},{passwords[sid]}\n" for sid in ids)
    write_private(paths.roster, roster)
    write_private(paths.hashes, json.dumps(hashes, indent=2) + "\n")
    return ids


def load_hashes(paths):
    if not paths.hashes.exists():
        raise LabError("명단이 없습니다. 먼저 `labctl init --students N`을 실행하세요.")
    hashes = json.loads(paths.hashes.read_text(encoding="utf-8"))
    return dict(sorted(hashes.items()))


def render_compose(ids, mode):
    if mode == "local":
        ports = [f'"127.0.0.1:{LOCAL_PORT}:{LOCAL_PORT}"']
    else:
        ports = ['"80:80"', '"443:443"']
    lines = [
        "# labctl render가 만든 파일입니다. 직접 고치지 마세요.",
        f"name: {PROJECT}",
        "services:",
        "  proxy:",
        f"    image: {CADDY_IMAGE}",
        "    container_name: lab-proxy",
        "    restart: unless-stopped",
        "    ports:",
        *[f"      - {p}" for p in ports],
        "    volumes:",
        "      - ./Caddyfile:/etc/caddy/Caddyfile:ro",
        "      - caddy-data:/data",
        "      - caddy-config:/config",
        "    networks:",
        *[f"      - net-{sid}" for sid in ids],
    ]
    for sid in ids:
        lines += [
            f"  {sid}:",
            f"    image: {STUDENT_IMAGE}",
            "    build:",
            "      context: ../image",
            f"    container_name: lab-{sid}",
            f"    hostname: {sid}",
            "    restart: unless-stopped",
            "    environment:",
            f"      TTYD_BASE_PATH: /{sid}",
            "    volumes:",
            f"      - home-{sid}:/home/student",
            "    networks:",
            f"      - net-{sid}",
            f"    mem_limit: {MEM_LIMIT}",
            f"    memswap_limit: {MEM_LIMIT}",
            f'    cpus: "{CPU_LIMIT}"',
            f"    pids_limit: {PIDS_LIMIT}",
        ]
    lines.append("networks:")
    for sid in ids:
        lines += [f"  net-{sid}:", f"    name: {PROJECT}-net-{sid}"]
    lines.append("volumes:")
    for sid in ids:
        lines += [f"  home-{sid}:", f"    name: {PROJECT}-home-{sid}"]
    lines += ["  caddy-data: {}", "  caddy-config: {}"]
    return "\n".join(lines) + "\n"


def render_caddyfile(hashes, mode, domain=None, tls_internal=False):
    if mode == "deploy":
        if not domain:
            raise LabError("deploy 모드에는 --domain이 필요합니다. (도메인이 없으면 <공인IP>.sslip.io)")
        if not DOMAIN_RE.match(domain):
            raise LabError(f"도메인 형식이 올바르지 않습니다: {domain}")
        site = domain
    else:
        site = f":{LOCAL_PORT}"
    lines = []
    if mode == "local":
        lines += ["{", "\tauto_https off", "}", ""]
    lines.append(f"{site} {{")
    if mode == "deploy":
        if tls_internal:
            lines.append("\ttls internal")
        lines += [
            "\theader {",
            "\t\tStrict-Transport-Security \"max-age=31536000\"",
            "\t\tX-Content-Type-Options nosniff",
            "\t}",
        ]
    for sid, hashed in hashes.items():
        lines += [
            f"\t@{sid} path /{sid} /{sid}/*",
            f"\thandle @{sid} {{",
            "\t\tbasic_auth {",
            f"\t\t\t{sid} {hashed}",
            "\t\t}",
            f"\t\treverse_proxy {sid}:{TTYD_PORT}",
            "\t}",
        ]
    lines += [
        "\thandle {",
        '\t\trespond "Campus Cloud Lab: 학생별 주소(/s01/ 처럼)로 접속하세요." 200',
        "\t}",
        "}",
    ]
    return "\n".join(lines) + "\n"


def cmd_render(paths, mode, domain=None, tls_internal=False):
    hashes = load_hashes(paths)
    caddyfile = render_caddyfile(hashes, mode, domain, tls_internal)
    compose = render_compose(list(hashes), mode)
    paths.out.mkdir(parents=True, exist_ok=True)
    paths.compose.write_text(compose, encoding="utf-8")
    paths.caddyfile.write_text(caddyfile, encoding="utf-8")  # 해시만 있고 평문은 없다
    return paths.compose, paths.caddyfile


def cmd_reset(paths, sid, run=subprocess.run):
    if not STUDENT_ID_RE.match(sid):
        raise LabError(f"학생 ID 형식은 s01 처럼 써야 합니다: {sid}")
    if sid not in load_hashes(paths):
        raise LabError(f"{sid} 는 명단에 없습니다.")
    if not paths.compose.exists():
        raise LabError("compose.yaml이 없습니다. 먼저 `labctl render`를 실행하세요.")
    compose = ["docker", "compose", "-f", str(paths.compose)]
    steps = [
        compose + ["rm", "--stop", "--force", "--volumes", sid],
        ["docker", "volume", "rm", "--force", f"{PROJECT}-home-{sid}"],
        compose + ["up", "-d", sid],
    ]
    for step in steps:
        try:
            run(step, check=True)
        except (subprocess.CalledProcessError, FileNotFoundError) as e:
            raise LabError(f"명령 실패: {' '.join(step)} ({e})")
    return steps


def build_parser():
    p = argparse.ArgumentParser(prog="labctl", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="command", required=True)
    pi = sub.add_parser("init", help="학생 비밀번호 생성")
    pi.add_argument("--students", type=int, required=True, metavar="N")
    pi.add_argument("--force", action="store_true", help="기존 명단을 덮어쓴다")
    pr = sub.add_parser("render", help="compose.yaml, Caddyfile 생성")
    pr.add_argument("--mode", choices=["local", "deploy"], required=True)
    pr.add_argument("--domain", help="deploy 모드의 도메인")
    pr.add_argument("--tls-internal", action="store_true",
                    help="자동 발급 대신 Caddy 내부 인증서 사용 (deploy 모드)")
    ps = sub.add_parser("reset", help="학생 홈 초기화")
    ps.add_argument("student", metavar="sNN")
    ps.add_argument("--yes", action="store_true", help="확인 없이 진행")
    return p


def main(argv=None, base=None):
    args = build_parser().parse_args(argv)
    paths = Paths(base or Path(__file__).resolve().parent)
    try:
        if args.command == "init":
            ids = cmd_init(paths, args.students, args.force)
            print(f"{len(ids)}명 생성: {ids[0]}..{ids[-1]}")
            print(f"평문 명단: {paths.roster} (커밋 금지, 관리자에게만 전달)")
        elif args.command == "render":
            if args.mode == "local" and (args.domain or args.tls_internal):
                raise LabError("--domain, --tls-internal은 deploy 모드에서만 씁니다.")
            compose, caddyfile = cmd_render(paths, args.mode, args.domain, args.tls_internal)
            print(f"생성: {compose}\n생성: {caddyfile}")
        elif args.command == "reset":
            if not args.yes:
                ans = input(f"{args.student} 의 홈 디렉터리를 지웁니다. 계속할까요? [y/N] ")
                if ans.strip().lower() != "y":
                    print("취소했습니다.")
                    return 1
            cmd_reset(paths, args.student)
            print(f"{args.student} 초기화 완료")
    except LabError as e:
        print(f"오류: {e}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
